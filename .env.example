APP_NAME="SecureAuth Admin"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com/secure-login
APP_KEY=replace-with-at-least-32-random-characters
APP_TIMEZONE=Asia/Kolkata
APP_FORCE_HTTPS=true

SETUP_TOKEN=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=secure-login
DB_USER=secure_login_user
DB_PASS=replace-with-database-password

SESSION_NAME=secure_login_sid
SESSION_COOKIE_PATH=/secure-login
SESSION_SAVE_PATH=
SESSION_IDLE_SECONDS=900
SESSION_ABSOLUTE_SECONDS=28800

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_SMTP_AUTH=true
MAIL_USERNAME=replace-with-smtp-username
MAIL_PASSWORD=replace-with-smtp-password
MAIL_FROM_EMAIL=no-reply@example.com
MAIL_FROM_NAME="SecureAuth Admin"
MAIL_TIMEOUT_SECONDS=10
